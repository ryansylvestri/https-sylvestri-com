{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/public .next/standalone/.next/static && cp -R public/. .next/standalone/public/ && cp -R .next/static/. .next/standalone/.next/static/",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node ./scripts/validate-content.mjs",
    "lead:smoke": "node ./scripts/lead-smoke.mjs",
    "lead:verify:live": "node ./scripts/verify-live-lead.mjs",
    "cloudinary:test-upload": "node ./scripts/test-cloudinary-signed-upload.mjs",
    "assets:worker": "node ./scripts/asset-worker.mjs",
    "plans:scaffold": "node ./scripts/scaffold-plans.mjs",
    "audit:sitemap": "node ./scripts/audit-sitemap.mjs",
    "audit:routes": "node ./scripts/audit-sitemap.mjs",
    "hostinger:verify": "npm run lint && npm run typecheck && npm run validate:content && npm run build",
    "hostinger:package": "bash ./ops/hostinger/package-upload.sh"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@types/nodemailer": "^7.0.11",
    "bullmq": "^5.71.1",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.10.1",
    "next": "16.1.6",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^8.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^21.0.1",
    "three": "^0.183.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
